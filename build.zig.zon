.{
    .name = .zregex,
    .version = "0.2.0-dev",
    // Globally unique package identifier together with `name`; never changes.
    .fingerprint = 0x9f5d80d30fd26c90, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // Win32 bindings, used by the JIT to map executable memory. Lazy so
        // that builds for other targets never fetch it.
        .zigwin32 = .{
            .url = "git+https://github.com/marlersoft/zigwin32#9f15c276b4e9d05afd34a10d8662a7dfc34647ea",
            .hash = "win32-42.0.39-preview-mX5pFS564gPTezZn4v3TMxRnfJUrZNx1B_F2p2HKXOeG",
            .lazy = true,
        },
        .uucode = .{
            .url = "git+https://github.com/jacobsandlund/uucode?ref=main#f67fa5dbef5c9de57773dbe2f7a02bebc7e20301",
            .hash = "uucode-0.2.0-ZZjBPvDKVAC0ZmoJJ37dlUn11y68rIKVeeovTLY9zxoQ",
        },
        // The oracle's reference, built from source by PCRE2's own upstream
        // build.zig (10.48 is the first release to ship one). Pinning it here
        // is what pins the reference semantics: the weekly CI's first run
        // failed on nothing but apt shipping an older PCRE2 whose POSIX
        // class behavior differs. Lazy, so builds that never wire the oracle
        // never fetch it.
        //
        // Taken from a mirror rather than the release tarball: 10.48's
        // build.zig names `Build.build_root`, which Zig 0.17 removed, and Zig
        // compiles every fetched dependency's build.zig, so upstream's breaks
        // every build of this project and not only the oracle. The mirror's
        // zig-0.17 branch is the pcre2-10.48 tag plus that one line; move
        // back to upstream once a release builds with 0.17.
        .pcre2 = .{
            .url = "git+https://git.jcollie.dev/jeff/pcre2.git#e58b5afbe91dbddfb47478db1f68d742c5c41155",
            .hash = "pcre2-10.48.0-IZ6r6wnVXgDvFPxmhnanI3-WSqYWp5jjtMmktcI9E2mz",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tools",
        "LICENSES",
        "README.md",
        "REUSE.toml",
    },
}
